prefix_rule(pattern=["swift", "test"], decision="allow")
prefix_rule(pattern=["swift", "package"], decision="allow")
prefix_rule(pattern=["git"], decision="allow")
prefix_rule(pattern=["gh", "pr"], decision="allow")
prefix_rule(pattern=["gh", "auth", "status"], decision="allow")
prefix_rule(pattern=["xcrun", "xcresulttool"], decision="allow")
prefix_rule(pattern=["xcrun", "swiftc"], decision="allow")
prefix_rule(pattern=["python3", "scripts/coverage.py"], decision="allow")
prefix_rule(pattern=["python3", "scripts/run-coverage.py"], decision="allow")
prefix_rule(pattern=["bash", "scripts/build-app.sh"], decision="allow")
prefix_rule(pattern=["xcodebuild", "-project", "Stillmatter.xcodeproj"], decision="allow")
prefix_rule(pattern=["xcodebuild", "test"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "swift test"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "bash scripts/build-app.sh"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "xcodebuild -project Stillmatter.xcodeproj -scheme Stillmatter"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "xcrun xcresulttool"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "swift package"], decision="allow")
prefix_rule(pattern=["plutil", "-convert", "json", "-o", "-", "Stillmatter.xcodeproj/project.pbxproj"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "xcodebuild test -project Stillmatter.xcodeproj"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "python3 scripts/run-coverage.py"], decision="allow")
prefix_rule(pattern=["/private/tmp/stillmatter-capture-preflight-02"], decision="allow")
prefix_rule(pattern=["cp", "/private/tmp/stillmatter-meeting-ai-01-final-policy.json", "scripts/coverage-policy.json"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "rg -n 'Test Suite|Test Case|Executed|passed|failed'"], decision="allow")
